[Unit]
Description=SIMUST public portal (my.simust.com)
After=network.target

[Service]
Type=simple
User=simust
Group=simust
WorkingDirectory=/opt/simust
EnvironmentFile=/opt/simust/.env
ExecStart=/opt/simust/.venv/bin/python /opt/simust/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
