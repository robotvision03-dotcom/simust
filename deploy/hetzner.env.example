# Copy to /opt/simust/.env on the Hetzner server. Do not commit real secrets.

SIMUST_PUBLIC_MODE=1
SIMUST_HOST=127.0.0.1
SIMUST_PORT=8000
SIMUST_PUBLIC_ORIGINS=https://simust.com,https://www.simust.com,https://my.simust.com

# Generated by deploy/hetzner-setup.sh
SIMUST_SESSION_SECRET=change-me
SIMUST_PUSH_KEY=change-me

SIMUST_REPORTS_DIR=/opt/simust/simust_reports
SIMUST_PLAYER_DIRECTORY=/opt/simust/simust_player
SIMUST_PUBLIC_BASE_URL=https://my.simust.com

# Stripe Checkout for 20 EUR / 30-minute bookings. Leave empty until keys are issued.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
