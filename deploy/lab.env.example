# Copy to lab.env next to app.py on the Windows training PC.
# Do not commit lab.env. Hashed passwords are sent; raw passwords are not.
#
# Without these two values, local lab Realtime Play still works, but
# http://157.180.47.98/operator cannot start SF-30N / any level on the lab.

SIMUST_PUSH_URL=http://157.180.47.98/internal/ingest-player-data
SIMUST_PUSH_KEY=paste-the-key-from-the-vps-/opt/simust/.env-SIMUST_PUSH_KEY

# After saving lab.env, restart the lab app.py. On /operator you must see:
#   "Lab online — Realtime Play from this tablet runs on the training machine…"
# If the banner says Lab offline, the tablet button stays disabled / start will fail.
